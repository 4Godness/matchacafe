const fs = require("fs");
const db = require("./connection");
const path = require("path");

const schemaPath = path.join(__dirname, "schema.sql");
const sql = fs.readFileSync(schemaPath, "utf8");

db.query(sql, (err) => {
    if (err) throw err;
    console.log("Database migrated successfully!");
    db.end();
});
